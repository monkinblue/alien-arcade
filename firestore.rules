rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidCallsign(val) {
      return val is string && val.matches('^[A-Z0-9_-]{1,12}$');
    }

    function isServerTimestamp(val) {
      return val == request.time;
    }

    // Program #1: LV-426 Lunar Lander (`scores`)
    match /scores/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'callsign',
          'score',
          'sector',
          'mode',
          'accuracy',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callsign',
          'score',
          'sector',
          'mode',
          'accuracy',
          'createdAt'
        ])
        && isValidCallsign(request.resource.data.callsign)
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 10000000
        && request.resource.data.sector is int
        && request.resource.data.sector >= 1
        && request.resource.data.sector <= 99
        && request.resource.data.mode is string
        && request.resource.data.mode in ['CAMPAIGN', 'ENDLESS']
        && request.resource.data.accuracy is int
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && isServerTimestamp(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // Program #2: Hadley's Perimeter (`perimeter_scores`)
    match /perimeter_scores/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'callsign',
          'score',
          'waves',
          'kills',
          'mode',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callsign',
          'score',
          'waves',
          'kills',
          'mode',
          'createdAt'
        ])
        && isValidCallsign(request.resource.data.callsign)
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 50000000
        && request.resource.data.waves is int
        && request.resource.data.waves >= 1
        && request.resource.data.waves <= 200
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.kills <= 100000
        && request.resource.data.mode is string
        && request.resource.data.mode in ['CAMPAIGN', 'ENDLESS']
        && isServerTimestamp(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // Program #3: Orbital Intercept // Flak Net (`flak_scores`)
    match /flak_scores/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'callsign',
          'score',
          'wave',
          'maxChain',
          'accuracy',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callsign',
          'score',
          'wave',
          'maxChain',
          'accuracy',
          'createdAt'
        ])
        && isValidCallsign(request.resource.data.callsign)
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 25000000
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1
        && request.resource.data.wave <= 99
        && request.resource.data.maxChain is int
        && request.resource.data.maxChain >= 1
        && request.resource.data.maxChain <= 32
        && request.resource.data.accuracy is int
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && isServerTimestamp(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // Program #4: Derelict Trench // Vector Run (`trench_scores`)
    match /trench_scores/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'callsign',
          'score',
          'distance',
          'maxMach',
          'grazes',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callsign',
          'score',
          'distance',
          'maxMach',
          'grazes',
          'createdAt'
        ])
        && isValidCallsign(request.resource.data.callsign)
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5000000
        && request.resource.data.distance is int
        && request.resource.data.distance >= 0
        && request.resource.data.distance <= 500000
        && request.resource.data.maxMach is number
        && request.resource.data.maxMach >= 0
        && request.resource.data.maxMach <= 5
        && request.resource.data.grazes is int
        && request.resource.data.grazes >= 0
        && request.resource.data.grazes <= 10000
        && isServerTimestamp(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // Program #5: Borealis Approach // LV-118 RAPCON (`approach_scores`)
    match /approach_scores/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'callsign',
          'score',
          'landed',
          'maxMult',
          'phase',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callsign',
          'score',
          'landed',
          'maxMult',
          'phase',
          'createdAt'
        ])
        && isValidCallsign(request.resource.data.callsign)
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 10000000
        && request.resource.data.landed is int
        && request.resource.data.landed >= 0
        && request.resource.data.landed <= 999
        && request.resource.data.maxMult is number
        && request.resource.data.maxMult >= 1
        && request.resource.data.maxMult <= 5
        && request.resource.data.phase is string
        && request.resource.data.phase in ['ALPHA', 'BRAVO', 'CHARLIE', 'DELTA', 'ECHO']
        && isServerTimestamp(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    // Default deny for all other paths & collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
